<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="AmllTtmlTool.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AmllTtmlTool.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="AppAccent">#E86A5C</Color>
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccent}" />
            <Style x:Key="RibbonGroup" TargetType="StackPanel">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Spacing" Value="6" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="RibbonCaption" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Style" Value="{StaticResource CaptionTextBlockStyle}" />
            </Style>
            <Style x:Key="RibbonSeparator" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="4,12" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
