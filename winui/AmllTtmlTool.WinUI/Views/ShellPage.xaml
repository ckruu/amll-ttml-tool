<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="AmllTtmlTool.WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:AmllTtmlTool.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <!-- Compact NavigationViewItem style: hug icon when labels are hidden. -->
        <Style x:Key="ModeNavCompactItemStyle" TargetType="NavigationViewItem">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnSaveAppleAccelerator" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewAccelerator" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAccelerator" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAccelerator" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="RootGrid" AllowDrop="True" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TitleStates" CurrentStateChanged="OnTitleStateChanged">
                <VisualState x:Name="FullTitle">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactTitle">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowTitle">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ToggleOverflowTitle">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Inset-driven title bar. LeftInsetCol and RightInsetCol carry the exact
            system-reserved widths, so no app content is ever laid out inside the
            caption-button strip. LeftStar and RightStar are equal, which centres
            the middle Auto column declaratively: no per-frame MinWidth math, and
            no way for the two halves to overlap.
        -->
        <Grid x:Name="TitleBarArea" Padding="8,0,0,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetCol" Width="0" />
                <ColumnDefinition x:Name="LeftStar" Width="*" MinWidth="0" />
                <ColumnDefinition x:Name="CenterCol" Width="Auto" />
                <ColumnDefinition x:Name="RightStar" Width="*" MinWidth="0" />
                <ColumnDefinition x:Name="RightInsetCol" Width="140" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" ColumnSpacing="4" MinWidth="0">
                <Grid.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Grid.Transitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>
            <MenuBar x:Name="MenuBarFull" VerticalAlignment="Center">
                <MenuBarItem x:Uid="Menu_File" Title="File">
                    <MenuFlyoutItem x:Uid="Menu_NewFile" Click="OnNewClick" Text="New file">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Menu_OpenLyrics" Click="OnOpenClick" Text="Open lyrics">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Menu_OpenClipboard" Click="OnPasteClick" Text="Open from clipboard">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_SaveTtml" Click="OnSaveClick" Text="Save TTML">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Menu_RestoreHistory" Click="OnStubClick" Text="Restore from history">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_CopyTtml" Click="OnCopyClick" Text="Copy TTML">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Menu_CopyApple" Click="OnCopyAppleClick" Text="Copy Apple TTML" />
                    <MenuFlyoutItem x:Uid="Menu_SaveApple" Click="OnSaveAppleClick" Text="Save Apple TTML" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_ImportLyrics" Click="OnOpenClick" Text="Import lyrics">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_Upload" Click="OnStubClick" Text="Upload to AMLL database">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem x:Uid="Menu_Edit" Title="Edit">
                    <MenuFlyoutItem x:Uid="Menu_Undo" Click="OnUndoClick" Text="Undo">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Menu_Redo" Click="OnRedoClick" Text="Redo">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="OnStubClick" Text="Select all lines">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Menu_DeselectAll" Click="OnStubClick" Text="Deselect all" />
                    <MenuFlyoutItem x:Uid="Menu_InvertSelection" Click="OnStubClick" Text="Invert selection" />
                    <MenuFlyoutItem x:Uid="Menu_SelectWordMatches" Click="OnStubClick" Text="Select word matches" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_DeleteWords" Click="OnStubClick" Text="Delete selected words">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_ShiftTime" Click="OnStubClick" Text="Shift time…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_EditMetadata" Click="OnStubClick" Text="Edit metadata…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_Preferences" Click="OnStubClick" Text="Preferences">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem x:Uid="Menu_Tools" Title="Tools">
                    <MenuFlyoutItem x:Uid="Menu_AutoSegment" Click="OnStubClick" Text="Auto segment" />
                    <MenuFlyoutItem x:Uid="Menu_AdvancedSegment" Click="OnStubClick" Text="Advanced segmentation…" />
                    <MenuFlyoutItem x:Uid="Menu_SmoothTimeline" Click="OnStubClick" Text="Smooth timeline…" />
                    <MenuFlyoutItem x:Uid="Menu_SyncTimestamps" Click="OnStubClick" Text="Sync line timestamps" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_DistributeRoman" Click="OnStubClick" Text="Auto-distribute romanization…" />
                    <MenuFlyoutItem x:Uid="Menu_CheckRoman" Click="OnStubClick" Text="Check romanization" />
                    <MenuFlyoutItem x:Uid="Menu_AutoRuby" Click="OnStubClick" Text="Auto ruby" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Menu_LatencyTest" Click="OnStubClick" Text="Audio latency test">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE917;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem x:Uid="Menu_Help" Title="Help">
                    <MenuFlyoutItem x:Uid="Menu_GitHub" Click="OnGitHubClick" Text="GitHub" />
                    <MenuFlyoutItem x:Uid="Menu_Docs" Click="OnDocsClick" Text="Docs" />
                </MenuBarItem>
            </MenuBar>
            <Button
                x:Name="MenuCompactButton"
                x:Uid="ShellPage_MenuCompact"
                Grid.Column="0"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Menu">
                <FontIcon FontSize="14" Glyph="&#xE700;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutSubItem x:Uid="Menu_File" Text="File">
                            <MenuFlyoutItem x:Uid="Menu_NewFile" Click="OnNewClick" Text="New file">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Menu_OpenLyrics" Click="OnOpenClick" Text="Open lyrics">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Menu_OpenClipboard" Click="OnPasteClick" Text="Open from clipboard">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_SaveTtml" Click="OnSaveClick" Text="Save TTML">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Menu_RestoreHistory" Click="OnStubClick" Text="Restore from history">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_CopyTtml" Click="OnCopyClick" Text="Copy TTML">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Menu_CopyApple" Click="OnCopyAppleClick" Text="Copy Apple TTML" />
                            <MenuFlyoutItem x:Uid="Menu_SaveApple" Click="OnSaveAppleClick" Text="Save Apple TTML" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_ImportLyrics" Click="OnOpenClick" Text="Import lyrics">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_Upload" Click="OnStubClick" Text="Upload to AMLL database">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_Edit" Text="Edit">
                            <MenuFlyoutItem x:Uid="Menu_Undo" Click="OnUndoClick" Text="Undo">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Menu_Redo" Click="OnRedoClick" Text="Redo">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="OnStubClick" Text="Select all lines">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Menu_DeselectAll" Click="OnStubClick" Text="Deselect all" />
                            <MenuFlyoutItem x:Uid="Menu_InvertSelection" Click="OnStubClick" Text="Invert selection" />
                            <MenuFlyoutItem x:Uid="Menu_SelectWordMatches" Click="OnStubClick" Text="Select word matches" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_DeleteWords" Click="OnStubClick" Text="Delete selected words">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_ShiftTime" Click="OnStubClick" Text="Shift time…" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_EditMetadata" Click="OnStubClick" Text="Edit metadata…" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_Preferences" Click="OnStubClick" Text="Preferences">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_Tools" Text="Tools">
                            <MenuFlyoutItem x:Uid="Menu_AutoSegment" Click="OnStubClick" Text="Auto segment" />
                            <MenuFlyoutItem x:Uid="Menu_AdvancedSegment" Click="OnStubClick" Text="Advanced segmentation…" />
                            <MenuFlyoutItem x:Uid="Menu_SmoothTimeline" Click="OnStubClick" Text="Smooth timeline…" />
                            <MenuFlyoutItem x:Uid="Menu_SyncTimestamps" Click="OnStubClick" Text="Sync line timestamps" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_DistributeRoman" Click="OnStubClick" Text="Auto-distribute romanization…" />
                            <MenuFlyoutItem x:Uid="Menu_CheckRoman" Click="OnStubClick" Text="Check romanization" />
                            <MenuFlyoutItem x:Uid="Menu_AutoRuby" Click="OnStubClick" Text="Auto ruby" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Menu_LatencyTest" Click="OnStubClick" Text="Audio latency test">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE917;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem x:Uid="Menu_Help" Text="Help">
                            <MenuFlyoutItem x:Uid="Menu_GitHub" Click="OnGitHubClick" Text="GitHub" />
                            <MenuFlyoutItem x:Uid="Menu_Docs" Click="OnDocsClick" Text="Docs" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Border x:Name="MenuDivider" Grid.Column="1" Width="1" Margin="4,14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel
                x:Name="UndoRedoPanel"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">
                <Button x:Name="UndoButton" x:Uid="ShellPage_Undo" Click="OnUndoClick" Style="{StaticResource SubtleTitleBarButtonStyle}" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                </Button>
                <Button x:Name="RedoButton" x:Uid="ShellPage_Redo" Click="OnRedoClick" Style="{StaticResource SubtleTitleBarButtonStyle}" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon FontSize="14" Glyph="&#xE7A6;" />
                </Button>
            </StackPanel>
            <Border x:Name="UndoDivider" Grid.Column="3" Width="1" Margin="4,14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid x:Name="FileInfoGrid" Grid.Column="4" ColumnSpacing="6" Margin="8,0" MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE8B7;" FontSize="14" />
                <TextBlock
                    x:Name="FileNameText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="lyric.ttml"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
            <Button
                x:Name="FileInfoButton"
                Grid.Column="4"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="lyric.ttml">
                <FontIcon VerticalAlignment="Center" Glyph="&#xE8B7;" FontSize="14" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="4" MinWidth="200">
                            <TextBlock
                                x:Name="FileInfoFlyoutName"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="lyric.ttml"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="FileInfoFlyoutDirty"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            </Grid>
            <StackPanel
                x:Name="CenterTitleBlock"
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <!-- RenderTransform (not composition Offset) so hit testing and
                     TransformToVisual follow the centering shift automatically.
                     No RepositionThemeTransition here: the shift below owns this
                     block's motion; a second driver would double-animate. -->
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="CenterNudge" />
                </StackPanel.RenderTransform>
                <StackPanel
                    x:Name="MasterTogglePanel"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                        <ToggleButton
                            x:Name="RomanToggle"
                            x:Uid="ShellPage_RomanToggle"
                            Click="OnMasterToggleClick"
                            Checked="OnPillCheckChanged"
                            Unchecked="OnPillCheckChanged"
                            Style="{StaticResource PillToggleStyle}"
                            ToolTipService.ToolTip="Romanization lines"
                            Width="36"
                            Margin="2">
                            <FontIcon FontSize="16" Glyph="&#xE7DE;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TransToggle"
                            x:Uid="ShellPage_TransToggle"
                            Click="OnMasterToggleClick"
                            Checked="OnPillCheckChanged"
                            Unchecked="OnPillCheckChanged"
                            Style="{StaticResource PillToggleStyle}"
                            ToolTipService.ToolTip="Translation lines"
                            Width="36"
                            Margin="2">
                            <FontIcon FontSize="16" Glyph="&#xE775;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="WordRomanToggle"
                            x:Uid="ShellPage_WordRomanToggle"
                            Click="OnMasterToggleClick"
                            Checked="OnPillCheckChanged"
                            Unchecked="OnPillCheckChanged"
                            Style="{StaticResource PillToggleStyle}"
                            ToolTipService.ToolTip="Per-word romanization"
                            Width="36"
                            Margin="2">
                            <FontIcon FontSize="16" Glyph="&#xE8E9;" />
                        </ToggleButton>
                    </StackPanel>
                <Button
                    x:Name="CenterToggleOverflowButton"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    MinWidth="44"
                    MinHeight="40"
                    AutomationProperties.AutomationId="CenterToggleOverflow"
                    Style="{StaticResource SubtleTitleBarButtonStyle}"
                    ToolTipService.ToolTip="Secondary content options">
                    <Button.Flyout>
                        <MenuFlyout x:Name="CenterToggleMenu" Opening="OnCenterToggleMenuOpening">
                            <ToggleMenuFlyoutItem
                                x:Name="RomanOverflowItem"
                                Tag="RomanToggle"
                                Text="Romanization lines"
                                Click="OnCenterToggleMenuItemClick">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE7DE;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem
                                x:Name="TransOverflowItem"
                                Tag="TransToggle"
                                Text="Translation lines"
                                Click="OnCenterToggleMenuItemClick">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE775;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem
                                x:Name="WordRomanOverflowItem"
                                Tag="WordRomanToggle"
                                Text="Per-word romanization"
                                Click="OnCenterToggleMenuItemClick">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE8E9;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                </Button>
                <NavigationView x:Name="ModeNavView"
                    VerticalAlignment="Center"
                    MinHeight="40"
                    Background="Transparent"
                    BorderThickness="0"
                    CompactModeThresholdWidth="0"
                    ExpandedModeThresholdWidth="0"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False"
                    IsTabStop="False"
                    PaneDisplayMode="Top"
                    SelectionFollowsFocus="Enabled"
                    SelectionChanged="OnModeNavSelectionChanged">
                    <NavigationView.Resources>
                        <!-- Title-bar nav sets no custom content and needs no
                             outer margin: reclaim the dead Top-pane columns. -->
                        <x:Double x:Key="TopNavigationViewPaneCustomContentMinWidth">0</x:Double>
                        <Thickness x:Key="TopNavigationViewTopNavGridMargin">0</Thickness>
                    </NavigationView.Resources>
                    <NavigationView.MenuItems>
                        <NavigationViewItem x:Name="EditNavItem" x:Uid="ShellPage_EditMode" Content="Edit" Tag="0" ToolTipService.ToolTip="Edit">
                            <NavigationViewItem.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE70F;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Name="SyncNavItem" x:Uid="ShellPage_SyncMode" Content="Sync" Tag="1" ToolTipService.ToolTip="Sync">
                            <NavigationViewItem.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE895;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Name="PreviewNavItem" x:Uid="ShellPage_PreviewMode" Content="Preview" Tag="2" ToolTipService.ToolTip="Preview">
                            <NavigationViewItem.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE8FF;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                </NavigationView>
            </StackPanel>
            <StackPanel
                x:Name="RightFullPanel"
                Grid.Column="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.Transitions>
                <Button x:Uid="ShellPage_History" Click="OnStubClick" Style="{StaticResource SubtleTitleBarButtonStyle}" ToolTipService.ToolTip="History">
                    <FontIcon FontSize="14" Glyph="&#xE81C;" />
                </Button>
                <Border Width="1" Margin="4,14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <SplitButton x:Uid="ShellPage_SaveSplit" Click="OnSaveSplitClick" Style="{StaticResource SubtleSplitButtonStyle}" ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="SaveMenu" Opening="OnSaveMenuOpening">
                            <RadioMenuFlyoutItem x:Name="SaveTtmlItem" Click="OnSaveFormatPicked" Text="TTML" Tag="ttml" />
                            <RadioMenuFlyoutItem x:Name="SaveAppleItem" Click="OnSaveFormatPicked" Text="Apple TTML" Tag="apple" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton x:Uid="ShellPage_CopySplit" Click="OnCopySplitClick" Style="{StaticResource SubtleSplitButtonStyle}" ToolTipService.ToolTip="Copy">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="CopyMenu" Opening="OnCopyMenuOpening">
                            <RadioMenuFlyoutItem x:Name="CopyTtmlItem" Click="OnCopyFormatPicked" Text="TTML" Tag="ttml" />
                            <RadioMenuFlyoutItem x:Name="CopyAppleItem" Click="OnCopyFormatPicked" Text="Apple TTML" Tag="apple" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Border Width="1" Margin="4,14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Uid="ShellPage_Export" Click="OnExportClick" Style="{StaticResource SubtleTitleBarButtonStyle}" ToolTipService.ToolTip="Export…">
                    <FontIcon FontSize="14" Glyph="&#xE7C3;" />
                </Button>
            </StackPanel>
            <SplitButton
                x:Name="RightCompactSplit"
                x:Uid="ShellPage_CopySplit"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnCopySplitClick"
                Style="{StaticResource SubtleSplitButtonStyle}"
                ToolTipService.ToolTip="Copy">
                <SplitButton.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </SplitButton.Transitions>
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="Menu_RestoreHistory" Click="OnStubClick" Text="Version History">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_SaveTtml" Click="OnSaveClick" Text="Save">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnCompactSavePicked" Text="Save as TTML" Tag="ttml" />
                        <MenuFlyoutItem Click="OnCompactSavePicked" Text="Save as Apple TTML" Tag="apple" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Menu_CopyTtml" Click="OnCopyClick" Text="Copy as TTML">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnCompactCopyPicked" Text="Copy as Apple TTML" Tag="apple" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Border x:Name="CaptionSpacer" Grid.Column="4" Width="140" />
        </Grid>

        <Border
            x:Name="RibbonCard"
            Grid.Row="1"
            Margin="8,0,8,8"
            Padding="4,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <controls:EditCommandBar x:Name="EditBar" HorizontalAlignment="Stretch" />
                <controls:SyncCommandBar x:Name="SyncBar" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                <controls:PreviewCommandBar x:Name="PreviewBar" Visibility="Collapsed" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8" Padding="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NavigationView
                x:Name="SidePane"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                IsPaneToggleButtonVisible="False"
                IsTabStop="False"
                PaneDisplayMode="Top"
                SelectionFollowsFocus="Enabled"
                Background="Transparent"
                SelectionChanged="OnSideTabChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="OutlineNavItem" x:Uid="ShellPage_OutlineTab" Content="Outline" Tag="Outline">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="BpmNavItem" x:Uid="ShellPage_BpmTab" Content="BPM" Tag="BPM">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE917;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="SidePreviewNavItem" x:Uid="ShellPage_SidePreviewTab" Content="Preview" Tag="SidePreview">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE786;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <TextBlock
                    x:Name="SideContent"
                    Margin="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Outline lands here in Phase 1."
                    TextWrapping="Wrap" />
            </NavigationView>
            <Frame x:Name="ContentFrame" Grid.Column="1" IsNavigationStackEnabled="False" Navigated="ContentFrame_Navigated">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </Grid>

        <InfoBar
            x:Name="NoticeBar"
            Grid.Row="3"
            Margin="8,4,8,0"
            IsOpen="False" />

        <!--
            Floating player bar (slice A): it lives in the content row with
            bottom alignment and a margin, so page content extends beneath
            it. Slice E gives scrolling pages bottom padding plus the
            acrylic background. Order: track, play, elapsed, seek (all
            remaining width, >=120px), total, eye, speed, spectrogram. The
            speaker button's volume functions move into the track tip
            (slice B); the pin slot is now the eye button (same stub
            behavior); the chevron (spectrogram) is unchanged, last.
        -->
        <Border
            Grid.Row="2"
            Margin="8"
            Padding="8,4"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AppBarButton
                    x:Name="TrackButton"
                    x:Uid="AudioBar_Track"
                    AutomationProperties.AutomationId="TrackButton"
                    AutomationProperties.Name="Track info"
                    Click="OnTrackButtonClick"
                    IsCompact="True"
                    TabIndex="0"
                    ToolTipService.ToolTip="Track info">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="PlayButton"
                    x:Uid="AudioBar_Play"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="PlayButton"
                    Click="OnPlayPauseClick"
                    Icon="Play"
                    IsCompact="True"
                    IsEnabled="False"
                    TabIndex="1"
                    ToolTipService.ToolTip="Play" />
                <TextBlock
                    x:Name="PositionText"
                    AutomationProperties.AutomationId="PositionText"
                    Grid.Column="2"
                    MinWidth="90"
                    VerticalAlignment="Center"
                    Text="00:00.000"
                    TextAlignment="Center"
                    Typography.NumeralAlignment="Tabular" />
                <Slider
                    x:Name="SeekSlider"
                    AutomationProperties.AutomationId="SeekSlider"
                    AutomationProperties.Name="Seek"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    Maximum="0"
                    Minimum="0"
                    MinWidth="120"
                    TabIndex="2"
                    Value="0"
                    ValueChanged="OnSeekValueChanged">
                    <!--
                      The slider domain is MILLISECONDS (double), not seconds:
                      a 4-minute track across ~900px is ~212ms per pixel, so a
                      100ms-throttled live seek could land a whole pixel away
                      and the text could not show the thumb's true ms. StepFrequency
                      1ms: the thumb is the truth while dragging.
                    -->
                    <Slider.StepFrequency>1</Slider.StepFrequency>
                </Slider>
                <TextBlock
                    x:Name="DurationText"
                    AutomationProperties.AutomationId="DurationText"
                    Grid.Column="4"
                    MinWidth="90"
                    VerticalAlignment="Center"
                    Text="00:00.000"
                    TextAlignment="Center"
                    Typography.NumeralAlignment="Tabular" />
                <AppBarButton
                    x:Name="EyeButton"
                    x:Uid="AudioBar_JumpToCurrent"
                    Grid.Column="5"
                    AutomationProperties.AutomationId="EyeButton"
                    AutomationProperties.Name="Jump to current lyric line"
                    Click="OnLocateClick"
                    IsCompact="True"
                    TabIndex="3"
                    ToolTipService.ToolTip="Jump to current lyric line">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE890;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <!--
                    Fixed width: sized once for the longest text ("1.25x") so
                    the button never resizes or moves as the speed changes.
                -->
                <Button
                    x:Name="RateButton"
                    Grid.Column="6"
                    AutomationProperties.AutomationId="RateButton"
                    AutomationProperties.Name="Playback speed"
                    MinWidth="64"
                    HorizontalContentAlignment="Center"
                    Content="1x"
                    Click="OnSpeedButtonClick"
                    TabIndex="4"
                    ToolTipService.ToolTip="Playback speed" />
                <AppBarToggleButton
                    x:Name="SpectroToggle"
                    x:Uid="AudioBar_Spectrogram"
                    Grid.Column="7"
                    AutomationProperties.AutomationId="SpectroToggle"
                    Click="OnSpectroClick"
                    IsCompact="True"
                    TabIndex="5"
                    ToolTipService.ToolTip="Spectrogram">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE70D;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </Grid>
        </Border>

        <!--
            Track tip (slice B): cover + title/artist-codec, in-app volume
            slider, volume-state + Open file + View in Explorer. Targeted at
            the track button, opens upward. Proportions follow the mockup;
            the tip's default width/padding are left alone.
        -->
        <TeachingTip
            x:Name="TrackTip"
            AutomationProperties.AutomationId="TrackTip"
            IsLightDismissEnabled="False"
            PreferredPlacement="Top"
            ShouldConstrainToRootBounds="True"
            Target="{x:Bind TrackButton}">
            <TeachingTip.Content>
                <Grid RowSpacing="8" MinWidth="300" MaxWidth="360">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="64" Height="64">
                            <Border
                                x:Name="TrackCoverPlaceholder"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xEC4F;" />
                            </Border>
                            <Border
                                x:Name="TrackCoverArt"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="TrackCoverBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="TrackTitleText"
                                AutomationProperties.AutomationId="TrackTitleText"
                                MaxLines="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="-"
                                TextTrimming="CharacterEllipsis" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="TrackArtistText"
                                    AutomationProperties.AutomationId="TrackArtistText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="-"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TrackCodecText"
                                    AutomationProperties.AutomationId="TrackCodecText"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="-" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Slider
                        x:Name="TipVolumeSlider"
                        AutomationProperties.AutomationId="TipVolumeSlider"
                        AutomationProperties.Name="Volume"
                        Grid.Row="1"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        Value="50"
                        ValueChanged="OnTipVolumeChanged" />
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="TipVolumeStateButton"
                            AutomationProperties.AutomationId="TipVolumeStateButton"
                            AutomationProperties.Name="Mute"
                            Width="40"
                            Height="36"
                            Padding="0"
                            Click="OnTipVolumeStateClick"
                            ToolTipService.ToolTip="Mute">
                            <FontIcon x:Name="TipVolumeStateGlyph" FontSize="16" Glyph="&#xE993;" />
                        </Button>
                        <Button
                            x:Name="TipOpenFileButton"
                            AutomationProperties.AutomationId="TipOpenFileButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="OnTipOpenFileClick"
                            Content="Open file" />
                        <Button
                            x:Name="TipExplorerButton"
                            AutomationProperties.AutomationId="TipExplorerButton"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Click="OnTipExplorerClick"
                            Content="View in Explorer" />
                    </Grid>
                </Grid>
            </TeachingTip.Content>
        </TeachingTip>

        <!--
            Speed tip (slice C): slider + Preserve pitch + preset row, in
            preset order 0.25x, 0.5x, 1x, 1.5x, 1.25x. The matching preset
            shows on (ToggleButton checked = accent); a non-preset speed
            leaves all off. Proportions follow the mockup; the tip's default
            width/padding are left alone.
        -->
        <TeachingTip
            x:Name="SpeedTip"
            AutomationProperties.AutomationId="SpeedTip"
            Title="Playback speed"
            IsLightDismissEnabled="False"
            PreferredPlacement="Top"
            ShouldConstrainToRootBounds="True"
            Target="{x:Bind RateButton}">
            <TeachingTip.Content>
                <Grid RowSpacing="8" MinWidth="280" MaxWidth="340">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider
                        x:Name="SpeedSlider"
                        AutomationProperties.AutomationId="SpeedSlider"
                        AutomationProperties.Name="Playback speed"
                        Maximum="2"
                        Minimum="0.25"
                        StepFrequency="0.05"
                        Value="1"
                        ValueChanged="OnSpeedSliderChanged" />
                    <CheckBox
                        x:Name="SpeedKeepPitch"
                        AutomationProperties.AutomationId="SpeedKeepPitch"
                        Grid.Row="1"
                        Content="Preserve pitch"
                        IsChecked="True"
                        Checked="OnKeepPitchChanged"
                        Unchecked="OnKeepPitchChanged" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                        <ToggleButton
                            x:Name="SpeedPreset025"
                            AutomationProperties.AutomationId="SpeedPreset025"
                            MinWidth="52"
                            Click="OnSpeedPresetClick"
                            Content="0.25x"
                            Tag="0.25" />
                        <ToggleButton
                            x:Name="SpeedPreset05"
                            AutomationProperties.AutomationId="SpeedPreset05"
                            MinWidth="52"
                            Click="OnSpeedPresetClick"
                            Content="0.5x"
                            Tag="0.5" />
                        <ToggleButton
                            x:Name="SpeedPreset1"
                            AutomationProperties.AutomationId="SpeedPreset1"
                            MinWidth="52"
                            Click="OnSpeedPresetClick"
                            Content="1x"
                            Tag="1" />
                        <ToggleButton
                            x:Name="SpeedPreset15"
                            AutomationProperties.AutomationId="SpeedPreset15"
                            MinWidth="52"
                            Click="OnSpeedPresetClick"
                            Content="1.5x"
                            Tag="1.5" />
                        <ToggleButton
                            x:Name="SpeedPreset125"
                            AutomationProperties.AutomationId="SpeedPreset125"
                            MinWidth="52"
                            Click="OnSpeedPresetClick"
                            Content="1.25x"
                            Tag="1.25" />
                    </StackPanel>
                </Grid>
            </TeachingTip.Content>
        </TeachingTip>

        <Border
            x:Name="DropOverlay"
            Grid.RowSpan="4"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Spacing="12" VerticalAlignment="Center">
                <FontIcon FontSize="48" Glyph="&#xE896;" />
                <TextBlock
                    x:Name="DropHintText"
                    x:Uid="ShellPage_DropHint"
                    FontSize="20"
                    Text="Drop to open" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
