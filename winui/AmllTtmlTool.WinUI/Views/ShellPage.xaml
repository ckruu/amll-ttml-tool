<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="AmllTtmlTool.WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:AmllTtmlTool.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Padding="16,0,12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon VerticalAlignment="Center" Glyph="&#xE950;" />
            <TextBlock
                x:Uid="ShellPage_Title"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="AMLL TTML Tool" />
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <RadioButton
                    x:Name="EditModeButton"
                    x:Uid="ShellPage_EditMode"
                    Content="Edit"
                    GroupName="Mode"
                    Checked="OnModeChecked" />
                <RadioButton
                    x:Name="SyncModeButton"
                    x:Uid="ShellPage_SyncMode"
                    Content="Sync"
                    GroupName="Mode"
                    Checked="OnModeChecked" />
                <RadioButton
                    x:Name="PreviewModeButton"
                    x:Uid="ShellPage_PreviewMode"
                    Content="Preview"
                    GroupName="Mode"
                    Checked="OnModeChecked" />
            </StackPanel>
            <TextBlock
                x:Name="FileNameText"
                Grid.Column="3"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="lyric.ttml" />
            <StackPanel
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ProgressBar
                    x:Name="SyncProgress"
                    Maximum="100"
                    Minimum="0"
                    Value="0"
                    Width="110" />
                <TextBlock
                    x:Name="SyncPercent"
                    MinWidth="40"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="—" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <controls:EditCommandBar x:Name="EditBar" />
                <controls:SyncCommandBar x:Name="SyncBar" Visibility="Collapsed" />
                <controls:PreviewCommandBar x:Name="PreviewBar" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8" Padding="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NavigationView
                x:Name="SidePane"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="Top"
                SelectionChanged="OnSideTabChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="ShellPage_OutlineTab" Content="Outline" Tag="Outline">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="ShellPage_BpmTab" Content="BPM" Tag="BPM">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE121;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="ShellPage_SidePreviewTab" Content="Preview" Tag="SidePreview">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE786;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <TextBlock
                    x:Name="SideContent"
                    Margin="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Outline lands here in Phase 1."
                    TextWrapping="Wrap" />
            </NavigationView>
            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>

        <Border
            Grid.Row="3"
            Margin="8,8,8,8"
            Padding="8,4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AppBarButton x:Uid="AudioBar_Load" Icon="Audio" Label="Load" />
                <AppBarButton
                    x:Name="PlayButton"
                    x:Uid="AudioBar_Play"
                    Grid.Column="1"
                    Icon="Play"
                    Label="Play" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="00:00.000" />
                <Slider
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    Value="0" />
                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Text="00:00.000" />
                <AppBarButton
                    x:Uid="AudioBar_Locate"
                    Grid.Column="5"
                    Label="Locate">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE138;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton
                    x:Uid="AudioBar_Spectrogram"
                    Grid.Column="6"
                    Label="Spectrogram">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE70D;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </Grid>
        </Border>
    </Grid>
</Page>
