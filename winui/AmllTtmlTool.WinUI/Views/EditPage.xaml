<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="AmllTtmlTool.WinUI.Views.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lyrics="using:AmllTtmlTool.Core.Lyrics"
    xmlns:controls="using:AmllTtmlTool.WinUI.Controls"
    mc:Ignorable="d">
    <Grid>
        <Grid>
        <ListView
            x:Name="LineList"
            SelectionMode="Extended"
            SelectionChanged="OnLineSelectionChanged"
            ContainerContentChanging="OnLineContainerChanging"
            KeyDown="OnLineListKeyDown"
            AutomationProperties.AutomationId="LineList"
            AutomationProperties.Name="Lyric lines">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="8,4,8,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border
                                    x:Name="Root"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="0.5" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <!-- SelectionStates deliberately empty:
                                             the accent bar + selected fill are
                                             driven from ONE source (the
                                             selection set) in code on every
                                             prepare/recycle/selection change.
                                             VSM-driven states leaked onto
                                             recycled containers (stale bars). -->
                                        <VisualStateGroup x:Name="SelectionStates">
                                            <VisualState x:Name="Unselected" />
                                            <VisualState x:Name="Selected" />
                                            <VisualState x:Name="SelectedUnfocused" />
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="FocusStates">
                                            <VisualState x:Name="Unfocused" />
                                            <VisualState x:Name="Focused">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid>
                                        <ContentPresenter
                                            HorizontalAlignment="Stretch"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        <!-- Accent bar OVERLAY on the card's
                                             left edge: same grid cell as the
                                             content, so it takes NO layout
                                             space and can never shift chips. -->
                                        <Rectangle
                                            x:Name="Pill"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Width="3"
                                            Margin="0,2,0,2"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            RadiusX="1.5"
                                            RadiusY="1.5"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lyrics:EditLine">
                    <!-- Transparent (not null) background: hit-testable
                         everywhere for press + right-click, visually unchanged. -->
                    <Grid x:Name="CardRoot" ColumnSpacing="12" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <!-- Fixed number column: the line number and the
                                 first chip start at the same x on EVERY line,
                                 selected or not, badges or not. -->
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LineNumber"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <!-- Chip row + add button: the button is centered
                                 on the WHOLE chip row (which can be two rows
                                 tall with per-word romaji), never on its top
                                 row, so it stays aligned as chips grow. -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:LyricWrapPanel
                                    x:Name="ChipPanel"
                                    Background="Transparent"
                                    HorizontalSpacing="6"
                                    VerticalSpacing="6" />
                                <Button
                                    x:Name="AddWordButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Add word">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                            </Grid>
                            <!-- RowSpacing mirrors ChipRowSpacing while both rows
                                 are visible; ApplyCardVisibility drops it to 0
                                 when one row is hidden so no leftover gap
                                 pads the card bottom. -->
                            <Grid x:Name="SubRows" ColumnSpacing="12" RowSpacing="{StaticResource ChipRowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Uid="EditPage_TransLabel"
                                    x:Name="TransLabel"
                                    Grid.Row="0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Translation" />
                                <TextBox
                                    x:Name="TransBox"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                <TextBlock
                                    x:Uid="EditPage_RomanLabel"
                                    x:Name="RomanLabel"
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Romanization" />
                                <TextBox
                                    x:Name="RomanBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                            </Grid>
                        </StackPanel>
                        <!-- Badges live RIGHT of the card, side by side,
                             centered, left of X, in a reserved fixed-width
                             area (MinWidth): showing/hiding them never
                             reflows the chip area or changes card height. -->
                        <StackPanel
                            x:Name="BadgePanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4"
                            MinWidth="64">
                            <Border
                                x:Name="BgBadge"
                                Padding="4,1"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed"
                                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                                ToolTipService.ToolTip="Background vocal">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Text="BG" />
                            </Border>
                            <Border
                                x:Name="DuetBadge"
                                Padding="4,1"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                ToolTipService.ToolTip="Duet vocal">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="V2" />
                            </Border>
                        </StackPanel>
                        <Button
                            x:Name="DeleteButton"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Delete line"
                            AutomationProperties.Name="Delete line">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
            <!-- Drag overlay: insertion line, ghost label. Hit-transparent;
                 same cell as the list so coordinates match 1:1. -->
            <Canvas x:Name="DragOverlay" IsHitTestVisible="False">
                <Rectangle
                    x:Name="DropLineMark"
                    Height="2"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    RadiusX="1"
                    RadiusY="1"
                    Visibility="Collapsed" />
                <Border
                    x:Name="DragGhost"
                    Background="{StaticResource AppAccentBrush}"
                    CornerRadius="12"
                    Padding="10,4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="DragGhostText"
                        Foreground="White"
                        FontSize="12" />
                </Border>
            </Canvas>
        </Grid>
        <!-- Empty state: shown while the document has no lines. -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            Spacing="8"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="EmptyStatePanel"
            AutomationProperties.Name="No lyrics loaded">
            <FontIcon
                FontSize="40"
                HorizontalAlignment="Center"
                Glyph="&#xE8B7;"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Uid="EditPage_EmptyTitle"
                FontSize="20"
                FontStyle="Normal"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Text="No lyrics yet" />
            <TextBlock
                x:Uid="EditPage_EmptyHint"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Import lyrics or drop a file here" />
            <Button
                x:Name="EmptyImportButton"
                HorizontalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnImportClick"
                AutomationProperties.AutomationId="EmptyImportButton"
                AutomationProperties.Name="Import lyrics">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock x:Uid="EditPage_EmptyImportLabel" Text="Import lyrics" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
