<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="AmllTtmlTool.WinUI.Views.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lyrics="using:AmllTtmlTool.Core.Lyrics"
    xmlns:controls="using:AmllTtmlTool.WinUI.Controls"
    mc:Ignorable="d">
    <Grid>
        <ListView
            x:Name="LineList"
            SelectionMode="Single"
            SelectionChanged="OnLineSelectionChanged"
            ContainerContentChanging="OnLineContainerChanging"
            AutomationProperties.AutomationId="LineList"
            AutomationProperties.Name="Lyric lines">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="8,4,8,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border
                                    x:Name="Root"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="0.5" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="SelectionStates">
                                            <VisualState x:Name="Unselected" />
                                            <VisualState x:Name="Selected">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Pill" Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="SelectedUnfocused">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Pill" Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="FocusStates">
                                            <VisualState x:Name="Unfocused" />
                                            <VisualState x:Name="Focused">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            x:Name="Pill"
                                            Width="3"
                                            Margin="0,4,8,4"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            RadiusX="1.5"
                                            RadiusY="1.5"
                                            Visibility="Collapsed" />
                                        <ContentPresenter
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lyrics:EditLine">
                    <Grid x:Name="CardRoot" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LineNumber"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <controls:LyricWrapPanel
                                x:Name="ChipPanel"
                                HorizontalSpacing="6"
                                VerticalSpacing="6" />
                            <Grid x:Name="SubRows" ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Uid="EditPage_TransLabel"
                                    Grid.Row="0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Translation" />
                                <TextBox
                                    x:Name="TransBox"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{x:Bind TranslatedLyric, Mode=OneWay}"
                                    IsReadOnly="True"
                                    IsTabStop="False" />
                                <TextBlock
                                    x:Uid="EditPage_RomanLabel"
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Romanization" />
                                <TextBox
                                    x:Name="RomanBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{x:Bind RomanLyric, Mode=OneWay}"
                                    IsReadOnly="True"
                                    IsTabStop="False" />
                            </Grid>
                        </StackPanel>
                        <Button
                            x:Name="DeleteButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Delete line (editing arrives in the next update)"
                            AutomationProperties.Name="Delete line">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!-- Empty state: shown while the document has no lines. -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            Spacing="8"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="EmptyStatePanel"
            AutomationProperties.Name="No lyrics loaded">
            <FontIcon
                FontSize="40"
                HorizontalAlignment="Center"
                Glyph="&#xE8B7;"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Uid="EditPage_EmptyTitle"
                FontSize="20"
                FontStyle="Normal"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Text="No lyrics yet" />
            <TextBlock
                x:Uid="EditPage_EmptyHint"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Import lyrics or drop a file here" />
            <Button
                x:Name="EmptyImportButton"
                HorizontalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnImportClick"
                AutomationProperties.AutomationId="EmptyImportButton"
                AutomationProperties.Name="Import lyrics">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock x:Uid="EditPage_EmptyImportLabel" Text="Import lyrics" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
