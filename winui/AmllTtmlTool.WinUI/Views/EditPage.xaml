<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="AmllTtmlTool.WinUI.Views.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <!-- Empty state: shown while the document has no lines. The line
             list (step 2) replaces the blank remainder of this Grid. -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            Spacing="8"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="EmptyStatePanel"
            AutomationProperties.Name="No lyrics loaded">
            <FontIcon
                FontSize="40"
                HorizontalAlignment="Center"
                Glyph="&#xE8B7;"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Uid="EditPage_EmptyTitle"
                FontSize="20"
                FontStyle="Normal"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Text="No lyrics yet" />
            <TextBlock
                x:Uid="EditPage_EmptyHint"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Import lyrics or drop a file here" />
            <Button
                x:Name="EmptyImportButton"
                HorizontalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnImportClick"
                AutomationProperties.AutomationId="EmptyImportButton"
                AutomationProperties.Name="Import lyrics">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock x:Uid="EditPage_EmptyImportLabel" Text="Import lyrics" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
