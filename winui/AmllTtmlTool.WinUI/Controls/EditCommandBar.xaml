<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="AmllTtmlTool.WinUI.Controls.EditCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AmllTtmlTool.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- No ScrollViewer here on purpose: a scrollable wrapper silently
         disables the VisualStateManager tiers below (verified by bisect:
         with a ScrollViewer the group stays stuck with no state applied and
         content clips; without it every tier engages). The tiers already
         cover every reachable width down to the 600px minimum, so a
         scrollbar fallback would only protect an unreachable state. -->
    <Grid x:Name="RootGrid" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthTiers" CurrentStateChanged="OnWidthTierChanged">
                <!-- Window-width triggers. The bar always measures exactly
                     42px under the client width (16 page margin + 8 card
                     padding + card chrome, verified constant across all
                     widths), so window thresholds are bar thresholds + 42.
                     AdaptiveTrigger is used instead of a custom
                     container-width trigger because it is the proven
                     mechanism in this app (the title-bar states already
                     run on it). Re-measure the offset if the card chrome
                     ever changes. Bar widths behind these numbers:
                     1110 + 900 + 720 + 470. -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1152" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="942" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="762" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ViewGroup.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="512" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ViewGroup.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ManageGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ManageOverflowButton.Visibility" Value="Visible" />
                        <!-- Shrink the inputs rather than dropping any label: every
                             field keeps its visible title at this width. -->
                        <Setter Target="LineStartBox.Width" Value="56" />
                        <Setter Target="LineEndBox.Width" Value="56" />
                        <Setter Target="WordStartBox.Width" Value="56" />
                        <Setter Target="WordEndBox.Width" Value="56" />
                        <Setter Target="WordContentBox.Width" Value="72" />
                        <Setter Target="ObsceneToggle.MinWidth" Value="72" />
                        <Setter Target="BgToggle.Visibility" Value="Collapsed" />
                        <Setter Target="DuetToggle.Visibility" Value="Collapsed" />
                        <Setter Target="IgnoreSyncToggle.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tiny">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ViewGroup.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ManageGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ManageOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="WordGroup.Visibility" Value="Collapsed" />
                        <Setter Target="WordOverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ManageGroup" Grid.Row="0" ColumnSpacing="2" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <!-- Slides surviving groups to their new position when a
                         tier collapses or restores a neighbor. Interruptible
                         and declarative: nothing runs per drag frame, and
                         within a tier nothing moves so resizes stay pure. -->
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Uid="Ribbon_Import" Click="OnStubClick" MinHeight="28">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock x:Uid="Ribbon_ImportLabel" Text="Import" />
                </StackPanel>
            </Button>
            <Button x:Uid="Ribbon_AddLine" Grid.Row="1" Click="OnNewLineClick" MinHeight="28">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock x:Uid="Ribbon_AddLineLabel" Text="Line" />
                </StackPanel>
            </Button>
        </Grid>

        <Button x:Name="ManageOverflowButton"
                Grid.Row="0"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                AutomationProperties.AutomationId="EditManageOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Import and add line">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="180">
                        <Button Click="OnStubClick" MinHeight="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnNewLineClick" MinHeight="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="Line" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE712;" />
        </Button>

        <!-- Separators belong to the group on their left and follow its
             Visibility, so none is ever left behind when a group collapses
             and none ever doubles up next to an empty cell. -->
        <Border x:Name="SepManageLine" Grid.Column="1" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind ManageGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="LineGroup" Grid.Column="2" ColumnSpacing="6" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LineStartLabel" x:Uid="Ribbon_LineStartLabel" Style="{StaticResource RibbonFieldLabel}" Text="Start" ToolTipService.ToolTip="Start" />
            <NumberBox x:Name="LineStartBox" Grid.Column="1" Minimum="0" Value="0" Width="88" MinHeight="28" AutomationProperties.Name="Start" />
            <ToggleButton x:Name="BgToggle" Grid.Column="2" Content="BG" MinHeight="28" MinWidth="56" />
            <ToggleButton x:Name="DuetToggle" Grid.Column="3" Content="V2" MinHeight="28" MinWidth="56" />
            <TextBlock x:Name="LineEndLabel" x:Uid="Ribbon_LineEndLabel" Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="End" ToolTipService.ToolTip="End" />
            <NumberBox x:Name="LineEndBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" Width="88" MinHeight="28" AutomationProperties.Name="End" />
            <ToggleButton x:Name="IgnoreSyncToggle" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Ignore Sync" HorizontalAlignment="Stretch" MinHeight="28" />
        </Grid>

        <Border x:Name="SepLineWord" Grid.Column="3" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind LineGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="WordGroup" Grid.Column="4" ColumnSpacing="6" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WordStartLabel" x:Uid="Ribbon_WordStartLabel" Style="{StaticResource RibbonFieldLabel}" Text="Start" ToolTipService.ToolTip="Start" />
            <NumberBox x:Name="WordStartBox" Grid.Column="1" Minimum="0" Value="0" Width="88" MinHeight="28" AutomationProperties.Name="Start" />
            <TextBlock x:Name="WordContentLabel" x:Uid="Ribbon_WordContentLabel" Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Content" ToolTipService.ToolTip="Content" />
            <TextBox x:Name="WordContentBox" Grid.Column="3" Width="120" MinHeight="28" AutomationProperties.Name="Content" />
            <TextBlock x:Name="WordEndLabel" x:Uid="Ribbon_WordEndLabel" Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="End" ToolTipService.ToolTip="End" />
            <NumberBox x:Name="WordEndBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" Width="88" MinHeight="28" AutomationProperties.Name="End" />
            <TextBlock x:Name="ObsceneLabel" x:Uid="Ribbon_ObsceneLabel" Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Obscene" ToolTipService.ToolTip="Obscene" />
            <ToggleButton x:Name="ObsceneToggle" Grid.Row="1" Grid.Column="3" Click="OnObsceneClick" Content="No" MinHeight="28" MinWidth="120" />
        </Grid>
        <Button x:Name="WordOverflowButton"
                Grid.Column="4"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EditWordOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Word fields">
            <Button.Flyout>
                <Flyout>
                    <Grid ColumnSpacing="6" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RibbonFieldLabel}" Text="Start" />
                        <NumberBox Grid.Column="1" Minimum="0" Width="88" MinHeight="28" AutomationProperties.Name="Start" Value="{x:Bind WordStartBox.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Content" />
                        <TextBox Grid.Column="3" Width="120" MinHeight="28" AutomationProperties.Name="Content" Text="{x:Bind WordContentBox.Text, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="End" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Minimum="0" Width="88" MinHeight="28" AutomationProperties.Name="End" Value="{x:Bind WordEndBox.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Obscene" />
                        <ToggleButton Grid.Row="1" Grid.Column="3" MinHeight="28" MinWidth="120" IsChecked="{x:Bind ObsceneToggle.IsChecked, Mode=TwoWay}" Content="{x:Bind ObsceneToggle.Content, Mode=OneWay}" Click="OnObsceneClick" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE8E9;" />
        </Button>

        <Border x:Name="SepWordSecondary" Grid.Column="5" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind WordGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="SecondaryGroup" Grid.Column="6" ColumnSpacing="6" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- One shared label column (sized to the longest label) plus one
                 star-sized input column, so both inputs share left edge, right
                 edge, and row height. Two separate row grids could never agree
                 on the label width: Romanization pushed its input right. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TransLabel" x:Uid="Ribbon_TransLabel" Style="{StaticResource RibbonFieldLabel}" Text="Translation" ToolTipService.ToolTip="Translation" />
            <TextBox x:Name="TransBox" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="120" MinHeight="28" AutomationProperties.Name="Translation" />
            <TextBlock x:Name="RomanLabel" x:Uid="Ribbon_RomanLabel" Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="Romanization" ToolTipService.ToolTip="Romanization" />
            <TextBox x:Name="RomanBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="120" MinHeight="28" AutomationProperties.Name="Romanization" />
        </Grid>
        <Button x:Name="SecondaryOverflowButton"
                Grid.Column="6"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EditSecondaryOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Translation and romanization">
            <Button.Flyout>
                <Flyout>
                    <Grid ColumnSpacing="6" RowSpacing="8" MinWidth="220">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FlyoutTransLabel" Style="{StaticResource RibbonFieldLabel}" Text="Translation" />
                        <TextBox x:Name="FlyoutTransBox" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="140" MinHeight="28" AutomationProperties.Name="Translation" Text="{x:Bind TransBox.Text, Mode=TwoWay}" />
                        <TextBlock x:Name="FlyoutRomanLabel" Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="Romanization" />
                        <TextBox x:Name="FlyoutRomanBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="140" MinHeight="28" AutomationProperties.Name="Romanization" Text="{x:Bind RomanBox.Text, Mode=TwoWay}" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE775;" />
        </Button>

        <Border x:Name="SepSecondaryView" Grid.Column="7" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind SecondaryGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="ViewGroup" Grid.Column="8" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="OutlineToggle" Click="OnViewToggleClick" Content="Outline" MinHeight="28" HorizontalAlignment="Stretch" />
                <ToggleButton x:Name="BpmToggle" Grid.Column="1" Click="OnViewToggleClick" Content="BPM" MinHeight="28" HorizontalAlignment="Stretch" />
                <ToggleButton x:Name="PreviewToggle" Grid.Column="2" Click="OnViewToggleClick" Content="Preview" MinHeight="28" HorizontalAlignment="Stretch" />
            </Grid>
            <ToggleButton x:Name="FollowToggle" Grid.Row="1" Click="OnViewToggleClick" Content="Follow Playback" HorizontalAlignment="Stretch" MinHeight="28" />
        </Grid>

        <Button x:Name="OverflowButton"
                Grid.Column="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                AutomationProperties.AutomationId="EditViewOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="View options">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="180">
                        <ToggleButton Content="Outline" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind OutlineToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                        <ToggleButton Content="BPM" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind BpmToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                        <ToggleButton Content="Preview" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind PreviewToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                        <ToggleButton Content="Follow Playback" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind FollowToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <Grid Width="20" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                <FontIcon Grid.Column="1" FontSize="16" Glyph="&#xE70D;" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
