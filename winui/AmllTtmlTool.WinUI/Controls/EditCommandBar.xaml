<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="AmllTtmlTool.WinUI.Controls.EditCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <StackPanel Style="{StaticResource RibbonGroup}">
                <Grid MinHeight="76" RowSpacing="6" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Uid="Ribbon_Import" Click="OnStubClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock x:Uid="Ribbon_ImportLabel" Text="Import" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Ribbon_AddLine" Grid.Row="1" Click="OnNewLineClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock x:Uid="Ribbon_AddLineLabel" Text="Line" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Uid="Ribbon_Manage" Style="{StaticResource RibbonCaption}" Text="Manage" />
            </StackPanel>
            <Border Style="{StaticResource RibbonSeparator}" />
            <StackPanel Style="{StaticResource RibbonGroup}">
                <Grid MinHeight="76" ColumnSpacing="8" RowSpacing="6" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Ribbon_LineStartLabel" VerticalAlignment="Center" Text="Start" />
                    <NumberBox x:Name="LineStartBox" Grid.Column="1" Minimum="0" Value="0" Width="110" />
                    <ToggleButton x:Name="BgToggle" Grid.Column="2" MinWidth="64" Content="BG" />
                    <TextBlock x:Uid="Ribbon_LineEndLabel" Grid.Row="1" VerticalAlignment="Center" Text="End" />
                    <NumberBox x:Name="LineEndBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" Width="110" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="DurationCheck" x:Uid="Ribbon_Duration" Content="Duration" VerticalAlignment="Center" />
                        <ToggleButton x:Name="DuetToggle" Content="V2" MinWidth="64" />
                        <ToggleButton x:Name="IgnoreSyncToggle" Content="Ignore Sync" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Uid="Ribbon_Line" Style="{StaticResource RibbonCaption}" Text="Line" />
            </StackPanel>
            <Border Style="{StaticResource RibbonSeparator}" />
            <StackPanel Style="{StaticResource RibbonGroup}">
                <Grid MinHeight="76" ColumnSpacing="8" RowSpacing="6" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Ribbon_WordStartLabel" VerticalAlignment="Center" Text="Start" />
                    <NumberBox x:Name="WordStartBox" Grid.Column="1" Minimum="0" Value="0" Width="110" />
                    <TextBlock x:Uid="Ribbon_WordEndLabel" Grid.Row="1" VerticalAlignment="Center" Text="End" />
                    <NumberBox x:Name="WordEndBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" Width="110" />
                </Grid>
                <Grid MinHeight="0" ColumnSpacing="8" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WordContentBox" x:Uid="Ribbon_WordContent" Header="Content" Width="180" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock x:Uid="Ribbon_ObsceneLabel" Text="Obscene" />
                        <ToggleButton x:Name="ObsceneToggle" Click="OnObsceneClick" Content="No" MinWidth="110" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Uid="Ribbon_Word" Style="{StaticResource RibbonCaption}" Text="Word" />
            </StackPanel>
            <Border Style="{StaticResource RibbonSeparator}" />
            <StackPanel Style="{StaticResource RibbonGroup}">
                <Grid MinHeight="76" ColumnSpacing="8" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TransSection" Spacing="2">
                        <TextBlock x:Uid="Ribbon_TransLabel" Text="Translation" />
                        <TextBox x:Name="TransBox" Width="180" />
                    </StackPanel>
                    <StackPanel x:Name="RomanSection" Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Ribbon_RomanLabel" Text="Romanization" />
                        <TextBox x:Name="RomanBox" Width="180" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Uid="Ribbon_Secondary" Style="{StaticResource RibbonCaption}" Text="Secondary content" />
            </StackPanel>
            <Border Style="{StaticResource RibbonSeparator}" />
            <StackPanel Style="{StaticResource RibbonGroup}">
                <Grid MinHeight="76" RowSpacing="6" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="OutlineToggle" Click="OnViewToggleClick" Content="Outline" MinWidth="80" />
                        <ToggleButton x:Name="BpmToggle" Click="OnViewToggleClick" Content="BPM" MinWidth="80" />
                        <ToggleButton x:Name="PreviewToggle" Click="OnViewToggleClick" Content="Preview" MinWidth="80" />
                    </StackPanel>
                    <ToggleButton x:Name="FollowToggle" Grid.Row="1" Click="OnViewToggleClick" Content="Follow Playback" HorizontalAlignment="Stretch" />
                </Grid>
                <TextBlock x:Uid="Ribbon_View" Style="{StaticResource RibbonCaption}" Text="View" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
