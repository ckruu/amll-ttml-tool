<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="AmllTtmlTool.WinUI.Controls.EditCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AmllTtmlTool.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- No ScrollViewer here on purpose: a scrollable wrapper silently
         disables the VisualStateManager tiers below (verified by bisect:
         with a ScrollViewer the group stays stuck with no state applied and
         content clips; without it every tier engages). The tiers already
         cover every reachable width down to the 600px minimum, so a
         scrollbar fallback would only protect an unreachable state. -->
    <Grid x:Name="RootGrid" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthTiers" CurrentStateChanged="OnWidthTierChanged">
                <!-- Window-width triggers. Available bar width = window - 26
                     (RibbonCard margins 16 + padding 8 + border 2); window
                     thresholds are bar thresholds + 42 (16 page margin + 8
                     card padding + card chrome + slack, verified constant).
                     Bar widths are MEASURED (edit-test tier notes), not
                     estimated — the 2-row Word section + count caption need
                     every tier below rebalanced; re-measure after ANY width
                     change. Measured multi-select bars: Wide 1357, Medium
                     1027, Narrow 803, Tight 645, Tiny ~320. Thresholds:
                     1400 + 1070 + 895 + 700 + 0.
                     States are EXCLUSIVE (not cumulative): each lists its
                     full setter set. -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1070" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="SecondaryOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ViewGroup.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="895" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="SecondaryOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ViewGroup.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ManageGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ManageOverflowButton.Visibility" Value="Visible" />
                        <!-- Shrink the inputs rather than dropping any label:
                             every field keeps its visible title at this width. -->
                        <Setter Target="LineStartBox.Width" Value="56" />
                        <Setter Target="LineEndBox.Width" Value="56" />
                        <Setter Target="WordStartBox.Width" Value="56" />
                        <Setter Target="WordEndBox.Width" Value="56" />
                        <Setter Target="WordContentBox.Width" Value="72" />
                        <Setter Target="ObsceneToggle.MinWidth" Value="72" />
                        <Setter Target="EmptyBeatBox.Width" Value="56" />
                        <Setter Target="WordRomanBox.Width" Value="72" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="SecondaryOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ViewGroup.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ManageGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ManageOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="LineStartBox.Width" Value="56" />
                        <Setter Target="LineEndBox.Width" Value="56" />
                        <Setter Target="WordStartBox.Width" Value="56" />
                        <Setter Target="WordEndBox.Width" Value="56" />
                        <Setter Target="WordContentBox.Width" Value="72" />
                        <Setter Target="ObsceneToggle.MinWidth" Value="72" />
                        <Setter Target="EmptyBeatBox.Width" Value="56" />
                        <Setter Target="WordRomanBox.Width" Value="72" />
                        <!-- The count caption would overflow the tight bar:
                             count stays available via the multi tooltips. -->
                        <Setter Target="WordCountCaption.Visibility" Value="Collapsed" />
                        <Setter Target="BgToggle.Visibility" Value="Collapsed" />
                        <Setter Target="DuetToggle.Visibility" Value="Collapsed" />
                        <Setter Target="IgnoreSyncToggle.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tiny">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="SecondaryOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ViewGroup.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ManageGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ManageOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="LineStartBox.Width" Value="56" />
                        <Setter Target="LineEndBox.Width" Value="56" />
                        <Setter Target="WordStartBox.Width" Value="56" />
                        <Setter Target="WordEndBox.Width" Value="56" />
                        <Setter Target="WordContentBox.Width" Value="72" />
                        <Setter Target="ObsceneToggle.MinWidth" Value="72" />
                        <Setter Target="EmptyBeatBox.Width" Value="56" />
                        <Setter Target="WordRomanBox.Width" Value="72" />
                        <Setter Target="WordCountCaption.Visibility" Value="Collapsed" />
                        <Setter Target="BgToggle.Visibility" Value="Collapsed" />
                        <Setter Target="DuetToggle.Visibility" Value="Collapsed" />
                        <Setter Target="IgnoreSyncToggle.Visibility" Value="Collapsed" />
                        <Setter Target="WordGroup.Visibility" Value="Collapsed" />
                        <Setter Target="WordOverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ManageGroup" Grid.Row="0" ColumnSpacing="2" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <!-- Slides surviving groups to their new position when a
                         tier collapses or restores a neighbor. Interruptible
                         and declarative: nothing runs per drag frame, and
                         within a tier nothing moves so resizes stay pure. -->
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Uid="Ribbon_Import" Click="OnImportClick" MinHeight="28">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock x:Uid="Ribbon_ImportLabel" Text="Import" />
                </StackPanel>
            </Button>
            <Button x:Uid="Ribbon_AddLine" Grid.Row="1" Click="OnNewLineClick" MinHeight="28">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock x:Uid="Ribbon_AddLineLabel" Text="Line" />
                </StackPanel>
            </Button>
        </Grid>

        <Button x:Name="ManageOverflowButton"
                Grid.Row="0"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                AutomationProperties.AutomationId="EditManageOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Import and add line">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="180">
                        <Button Click="OnImportClick" MinHeight="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnNewLineClick" MinHeight="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="Line" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE712;" />
        </Button>

        <!-- Separators belong to the group on their left and follow its
             Visibility, so none is ever left behind when a group collapses
             and none ever doubles up next to an empty cell. -->
        <Border x:Name="SepManageLine" Grid.Column="1" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind ManageGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="LineGroup" Grid.Column="2" ColumnSpacing="6" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LineStartLabel" x:Uid="Ribbon_LineStartLabel" Style="{StaticResource RibbonFieldLabel}" Text="Start" ToolTipService.ToolTip="Start" />
            <TextBox x:Name="LineStartBox" AutomationProperties.AutomationId="LineStartBox" Grid.Column="1" Width="80" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Line start time" />
            <ToggleButton x:Name="BgToggle" Grid.Column="2" Content="BG" MinHeight="28" MinWidth="56" Click="OnLineFlagClick" AutomationProperties.AutomationId="BgToggle" />
            <ToggleButton x:Name="DuetToggle" Grid.Column="3" Content="V2" MinHeight="28" MinWidth="56" Click="OnLineFlagClick" AutomationProperties.AutomationId="DuetToggle" />
            <Button x:Name="LineEndModeButton" Grid.Row="1" Style="{StaticResource SubtleTitleBarButtonStyle}" MinHeight="28" Click="OnDurationModeClick" AutomationProperties.AutomationId="LineEndModeButton" ToolTipService.ToolTip="Toggle end / duration">
                <TextBlock x:Name="LineEndModeLabel" x:Uid="Ribbon_LineEndLabel" Style="{StaticResource RibbonFieldLabel}" Text="End" />
            </Button>
            <TextBox x:Name="LineEndBox" AutomationProperties.AutomationId="LineEndBox" Grid.Row="1" Grid.Column="1" Width="80" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Line end time" />
            <ToggleButton x:Name="IgnoreSyncToggle" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Ignore Sync" HorizontalAlignment="Stretch" MinHeight="28" Click="OnLineFlagClick" AutomationProperties.AutomationId="IgnoreSyncToggle" />
        </Grid>

        <Border x:Name="SepLineWord" Grid.Column="3" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind LineGroup.Visibility, Mode=OneWay}" />

        <!-- Word section: TWO rows (not three), three field pairs per the
             original's wordTiming + wordProperties sections: (Start, End),
             (Content, Obscene), (Beats, Roman). Beats and Roman share the
             third pair's columns, so hiding Roman (toggle off) leaves no
             leftover space: the columns keep Beats' width. The selection
             count caption (last column, code-zeroed when hidden) never
             affects the field columns. -->
        <Grid x:Name="WordGroup" Grid.Column="4" ColumnSpacing="4" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WordStartLabel" x:Uid="Ribbon_WordStartLabel" Style="{StaticResource RibbonFieldLabel}" Text="Start" ToolTipService.ToolTip="Start" />
            <TextBox x:Name="WordStartBox" AutomationProperties.AutomationId="WordStartBox" Grid.Column="1" Width="80" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Word start time" />
            <TextBlock x:Name="WordContentLabel" x:Uid="Ribbon_WordContentLabel" Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Content" ToolTipService.ToolTip="Content" />
            <TextBox x:Name="WordContentBox" AutomationProperties.AutomationId="WordContentBox" Grid.Column="3" Width="88" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Word content" />
            <TextBlock x:Name="EmptyBeatLabel" Style="{StaticResource RibbonFieldLabel}" Grid.Column="4" Text="Beats" ToolTipService.ToolTip="Empty beat count" />
            <TextBox x:Name="EmptyBeatBox" AutomationProperties.AutomationId="EmptyBeatBox" Grid.Column="5" Width="80" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" InputScope="Number" AutomationProperties.Name="Empty beat count" />
            <TextBlock x:Name="WordCountCaption" Grid.Column="6" Grid.RowSpan="2" VerticalAlignment="Center" Style="{StaticResource RibbonFieldLabel}" Visibility="Collapsed" AutomationProperties.Name="Selected word count" />
            <Button x:Name="WordEndModeButton" Grid.Row="1" Style="{StaticResource SubtleTitleBarButtonStyle}" MinHeight="28" Click="OnDurationModeClick" AutomationProperties.AutomationId="WordEndModeButton" ToolTipService.ToolTip="Toggle end / duration">
                <TextBlock x:Name="WordEndModeLabel" x:Uid="Ribbon_WordEndLabel" Style="{StaticResource RibbonFieldLabel}" Text="End" />
            </Button>
            <TextBox x:Name="WordEndBox" AutomationProperties.AutomationId="WordEndBox" Grid.Row="1" Grid.Column="1" Width="80" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Word end time" />
            <TextBlock x:Name="ObsceneLabel" x:Uid="Ribbon_ObsceneLabel" Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Obscene" ToolTipService.ToolTip="Obscene" />
            <ToggleButton x:Name="ObsceneToggle" Grid.Row="1" Grid.Column="3" Click="OnObsceneClick" Content="No" MinHeight="28" MinWidth="100" AutomationProperties.AutomationId="ObsceneToggle" />
            <TextBlock x:Name="WordRomanLabel" Style="{StaticResource RibbonFieldLabel}" Grid.Row="1" Grid.Column="4" Text="Roman" ToolTipService.ToolTip="Word romanization" />
            <TextBox x:Name="WordRomanBox" AutomationProperties.AutomationId="WordRomanBox" Grid.Row="1" Grid.Column="5" Width="88" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Word romanization" />
        </Grid>
        <Button x:Name="WordOverflowButton"
                Grid.Column="4"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EditWordOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Word fields">
            <Button.Flyout>
                <Flyout>
                    <Grid ColumnSpacing="6" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RibbonFieldLabel}" Text="Start" />
                        <TextBox Grid.Column="1" Width="80" MinHeight="28" IsReadOnly="True" AutomationProperties.Name="Start" Text="{x:Bind WordStartBox.Text, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Content" />
                        <TextBox Grid.Column="3" Width="88" MinHeight="28" IsReadOnly="True" AutomationProperties.Name="Content" Text="{x:Bind WordContentBox.Text, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource RibbonFieldLabel}" Text="Beats" />
                        <TextBox Grid.Column="5" Width="80" MinHeight="28" IsReadOnly="True" AutomationProperties.Name="Beats" Text="{x:Bind EmptyBeatBox.Text, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="End" />
                        <TextBox Grid.Row="1" Grid.Column="1" Width="80" MinHeight="28" IsReadOnly="True" AutomationProperties.Name="End" Text="{x:Bind WordEndBox.Text, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonFieldLabel}" Text="Obscene" />
                        <ToggleButton Grid.Row="1" Grid.Column="3" MinHeight="28" MinWidth="100" IsEnabled="False" IsChecked="{x:Bind ObsceneToggle.IsChecked, Mode=OneWay}" Content="{x:Bind ObsceneToggle.Content, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource RibbonFieldLabel}" Text="Roman" />
                        <TextBox Grid.Row="1" Grid.Column="5" Width="88" MinHeight="28" IsReadOnly="True" AutomationProperties.Name="Roman" Text="{x:Bind WordRomanBox.Text, Mode=OneWay}" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE8E9;" />
        </Button>

        <Border x:Name="SepWordSecondary" Grid.Column="5" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind WordGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="SecondaryGroup" Grid.Column="6" ColumnSpacing="6" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- One shared label column (sized to the longest label) plus one
                 star-sized input column, so both inputs share left edge, right
                 edge, and row height. Two separate row grids could never agree
                 on the label width: Romanization pushed its input right. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TransLabel" x:Uid="Ribbon_TransLabel" Style="{StaticResource RibbonFieldLabel}" Text="Translation" ToolTipService.ToolTip="Translation" />
            <TextBox x:Name="TransBox" AutomationProperties.AutomationId="TransBox" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="120" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Line translation" />
            <TextBlock x:Name="RomanLabel" x:Uid="Ribbon_RomanLabel" Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="Romanization" ToolTipService.ToolTip="Romanization" />
            <TextBox x:Name="RomanBox" AutomationProperties.AutomationId="RomanBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="120" MinHeight="28" AcceptsReturn="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Line romanization" />
        </Grid>
        <Button x:Name="SecondaryOverflowButton"
                Grid.Column="6"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EditSecondaryOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Translation and romanization">
            <Button.Flyout>
                <Flyout>
                    <Grid ColumnSpacing="6" RowSpacing="8" MinWidth="220">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FlyoutTransLabel" Style="{StaticResource RibbonFieldLabel}" Text="Translation" />
                        <TextBox x:Name="FlyoutTransBox" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="140" MinHeight="28" IsReadOnly="True" AutomationProperties.Name="Translation" Text="{x:Bind TransBox.Text, Mode=OneWay}" />
                        <TextBlock x:Name="FlyoutRomanLabel" Grid.Row="1" Style="{StaticResource RibbonFieldLabel}" Text="Romanization" />
                        <TextBox x:Name="FlyoutRomanBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="140" MinHeight="28" IsReadOnly="True" AutomationProperties.Name="Romanization" Text="{x:Bind RomanBox.Text, Mode=OneWay}" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE775;" />
        </Button>

        <Border x:Name="SepSecondaryView" Grid.Column="7" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind SecondaryGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="ViewGroup" Grid.Column="8" RowSpacing="4" VerticalAlignment="Top" Margin="6,6,6,6">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="OutlineToggle" Click="OnViewToggleClick" Content="Outline" MinHeight="28" HorizontalAlignment="Stretch" />
                <ToggleButton x:Name="BpmToggle" Grid.Column="1" Click="OnViewToggleClick" Content="BPM" MinHeight="28" HorizontalAlignment="Stretch" />
                <ToggleButton x:Name="PreviewToggle" Grid.Column="2" Click="OnViewToggleClick" Content="Preview" MinHeight="28" HorizontalAlignment="Stretch" />
            </Grid>
            <ToggleButton x:Name="FollowToggle" Grid.Row="1" Click="OnViewToggleClick" Content="Follow Playback" HorizontalAlignment="Stretch" MinHeight="28" />
        </Grid>

        <Button x:Name="OverflowButton"
                Grid.Column="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                AutomationProperties.AutomationId="EditViewOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="View options">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="180">
                        <ToggleButton Content="Outline" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind OutlineToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                        <ToggleButton Content="BPM" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind BpmToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                        <ToggleButton Content="Preview" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind PreviewToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                        <ToggleButton Content="Follow Playback" MinHeight="28" HorizontalAlignment="Stretch" IsChecked="{x:Bind FollowToggle.IsChecked, Mode=TwoWay}" Click="OnViewToggleClick" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <Grid Width="20" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                <FontIcon Grid.Column="1" FontSize="16" Glyph="&#xE70D;" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
