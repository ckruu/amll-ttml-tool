<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="AmllTtmlTool.WinUI.Controls.SyncCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AmllTtmlTool.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- No ScrollViewer here on purpose: a scrollable wrapper silently
         disables the VisualStateManager tiers (verified by bisect on the
         Edit bar). The tiers cover every reachable width, so no fallback
         scroller is needed. -->
    <Grid x:Name="RootGrid" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthTiers">
                <!-- Window-width triggers; bar measures exactly 42px under the
                     client width (see EditCommandBar). Bar widths: 1480 + 1180
                     + 960 + 740. -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1522" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1222" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="KeysGroup.Visibility" Value="Collapsed" />
                        <Setter Target="KeysOverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1002" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="KeysGroup.Visibility" Value="Collapsed" />
                        <Setter Target="KeysOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ViewsGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ViewsOverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="782" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="KeysGroup.Visibility" Value="Collapsed" />
                        <Setter Target="KeysOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ViewsGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ViewsOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="SecondaryOverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tiny">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="KeysGroup.Visibility" Value="Collapsed" />
                        <Setter Target="KeysOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ViewsGroup.Visibility" Value="Collapsed" />
                        <Setter Target="ViewsOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="SecondaryGroup.Visibility" Value="Collapsed" />
                        <Setter Target="SecondaryOverflowButton.Visibility" Value="Visible" />
                        <Setter Target="WordGroup.Visibility" Value="Collapsed" />
                        <Setter Target="WordOverflowButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ManageGroup" Grid.Column="0" Margin="6,6,6,6" RowSpacing="4" VerticalAlignment="Top">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Slider x:Name="EmptyBeatSlider" x:Uid="Ribbon_EmptyBeatSlider" Header="Empty beats" Maximum="8" Minimum="0" StepFrequency="1" Width="120" />
                <TextBlock x:Name="BeatCountText" VerticalAlignment="Center" Text="0 / 0" />
            </StackPanel>
        </Grid>
        <!-- Separators belong to the group on their left and follow its
             Visibility, so none is ever left behind when a group collapses
             and none ever doubles up next to an empty cell. -->
        <Border x:Name="SepManageLine" Grid.Column="1" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind ManageGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="LineGroup" Grid.Column="2" Margin="6,6,6,6" VerticalAlignment="Center">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <NumberBox x:Name="OffsetBox" x:Uid="Ribbon_TimeOffset" Header="Offset (ms)" Value="0" Width="110" MinHeight="28" />
        </Grid>
        <Border x:Name="SepLineWord" Grid.Column="3" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind LineGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="WordGroup" Grid.Column="4" Margin="6,6,6,6" ColumnSpacing="12" RowSpacing="2" VerticalAlignment="Top">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="TimestampUpdateCheck" x:Uid="Ribbon_TimestampUpdate" Content="Timestamp preview" VerticalAlignment="Center" />
            <CheckBox x:Name="TouchPanelCheck" x:Uid="Ribbon_TouchPanel" Grid.Row="1" Content="Touch panel" VerticalAlignment="Center" />
            <CheckBox x:Name="BgIgnoreCheck" x:Uid="Ribbon_BgIgnore" Grid.Column="1" Grid.RowSpan="2" Content="BG lines ignore sync" VerticalAlignment="Center" />
        </Grid>
        <Button x:Name="WordOverflowButton"
                Grid.Column="4"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SyncWordOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Assist options">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="200">
                        <CheckBox Content="Timestamp preview" IsChecked="{x:Bind TimestampUpdateCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="Touch panel" IsChecked="{x:Bind TouchPanelCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="BG lines ignore sync" IsChecked="{x:Bind BgIgnoreCheck.IsChecked, Mode=TwoWay}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE8E9;" />
        </Button>
        <Border x:Name="SepWordSecondary" Grid.Column="5" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind WordGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="SecondaryGroup" Grid.Column="6" Margin="6,6,6,6" ColumnSpacing="12" RowSpacing="2" VerticalAlignment="Top">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="ShowStampsCheck" x:Uid="Ribbon_ShowStamps" Content="Timestamps" IsChecked="True" />
            <CheckBox x:Name="HighlightWordCheck" x:Uid="Ribbon_HighlightWord" Grid.Column="1" Content="Highlight syllable" IsChecked="True" />
            <CheckBox x:Name="HighlightErrCheck" x:Uid="Ribbon_HighlightErr" Grid.Row="1" Content="Highlight errors" IsChecked="True" />
            <CheckBox x:Name="WrapCheck" x:Uid="Ribbon_Wrap" Grid.Row="1" Grid.Column="1" Content="Wrap words" IsChecked="True" />
        </Grid>
        <Button x:Name="SecondaryOverflowButton"
                Grid.Column="6"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SyncDisplayOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Display options">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="200">
                        <CheckBox Content="Timestamps" IsChecked="{x:Bind ShowStampsCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="Highlight syllable" IsChecked="{x:Bind HighlightWordCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="Highlight errors" IsChecked="{x:Bind HighlightErrCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="Wrap words" IsChecked="{x:Bind WrapCheck.IsChecked, Mode=TwoWay}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE8E9;" />
        </Button>
        <Border x:Name="SepSecondaryViews" Grid.Column="7" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind SecondaryGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="ViewsGroup" Grid.Column="8" Margin="6,6,6,6" ColumnSpacing="12" RowSpacing="2" VerticalAlignment="Top">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="SyncOutlineCheck" x:Uid="Ribbon_SyncOutline" Content="Outline" />
            <CheckBox x:Name="SyncBpmCheck" x:Uid="Ribbon_SyncBpm" Grid.Column="1" Content="BPM" />
            <CheckBox x:Name="SyncPreviewCheck" x:Uid="Ribbon_SyncPreview" Grid.Row="1" Content="Preview" />
            <CheckBox x:Name="SyncFollowCheck" x:Uid="Ribbon_SyncFollow" Grid.Row="1" Grid.Column="1" Content="Follow playback" />
        </Grid>
        <Button x:Name="ViewsOverflowButton"
                Grid.Column="8"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SyncViewsOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Views">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="200">
                        <CheckBox Content="Outline" IsChecked="{x:Bind SyncOutlineCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="BPM" IsChecked="{x:Bind SyncBpmCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="Preview" IsChecked="{x:Bind SyncPreviewCheck.IsChecked, Mode=TwoWay}" />
                        <CheckBox Content="Follow playback" IsChecked="{x:Bind SyncFollowCheck.IsChecked, Mode=TwoWay}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE8FD;" />
        </Button>
        <Border x:Name="SepViewsKeys" Grid.Column="9" Grid.RowSpan="1" Style="{StaticResource RibbonSeparator}" Visibility="{x:Bind ViewsGroup.Visibility, Mode=OneWay}" />

        <Grid x:Name="KeysGroup" Grid.Column="10" Margin="6,6,6,6" VerticalAlignment="Top">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                <Button x:Uid="Ribbon_StartSync" Content="Start: Space" MinHeight="28" />
                <Button x:Uid="Ribbon_NextSync" Content="Next: Tab" Style="{StaticResource AccentButtonStyle}" MinHeight="28" />
                <Button x:Uid="Ribbon_EndSync" Content="End: Enter" MinHeight="28" />
            </StackPanel>
        </Grid>
        <Button x:Name="KeysOverflowButton"
                Grid.Column="10"
                Visibility="Collapsed"
                MinWidth="44"
                MinHeight="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SyncKeysOverflow"
                Style="{StaticResource SubtleTitleBarButtonStyle}"
                ToolTipService.ToolTip="Sync keys">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="8" MinWidth="180">
                        <Button Content="Start: Space" MinHeight="28" HorizontalAlignment="Stretch" />
                        <Button Content="Next: Tab" Style="{StaticResource AccentButtonStyle}" MinHeight="28" HorizontalAlignment="Stretch" />
                        <Button Content="End: Enter" MinHeight="28" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <FontIcon FontSize="16" Glyph="&#xE765;" />
        </Button>
    </Grid>
</UserControl>
