<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="AmllTtmlTool.WinUI.Controls.PreviewCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer x:Name="BarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Full">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FadeBox.Width" Value="88" />
                        <Setter Target="FontBox.Width" Value="80" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BarScroll.HorizontalScrollBarVisibility" Value="Visible" />
                        <Setter Target="LyricsCaption.Visibility" Value="Collapsed" />
                        <Setter Target="WordCaption.Visibility" Value="Collapsed" />
                        <Setter Target="ViewCaption.Visibility" Value="Collapsed" />
                        <Setter Target="StyleCaption.Visibility" Value="Collapsed" />
                        <Setter Target="BgCaption.Visibility" Value="Collapsed" />
                        <Setter Target="FadeBox.Width" Value="80" />
                        <Setter Target="FontBox.Width" Value="72" />
                        <Setter Target="EmphasisSlider.Width" Value="80" />
                        <Setter Target="GlowSlider.Width" Value="80" />
                        <Setter Target="LiftSlider.Width" Value="80" />
                        <Setter Target="AnimSpeedSlider.Width" Value="80" />
                        <Setter Target="InactiveScaleSlider.Width" Value="80" />
                        <Setter Target="CascadeSlider.Width" Value="80" />
                        <Setter Target="BlurSlider.Width" Value="80" />
                        <Setter Target="BrightnessSlider.Width" Value="80" />
                        <Setter Target="ContrastSlider.Width" Value="80" />
                        <Setter Target="SaturationSlider.Width" Value="80" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8,6,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12" RowSpacing="2" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Uid="Ribbon_PrevTrans" Content="Translation" />
                    <CheckBox x:Uid="Ribbon_PrevRoman" Grid.Row="1" Content="Romanization" />
                    <CheckBox x:Uid="Ribbon_PrevMask" Grid.Column="1" Grid.RowSpan="2" Content="Mask explicit" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="LyricsCaption" x:Uid="Ribbon_PrevLyrics" Grid.Row="1" Style="{StaticResource RibbonCaption}" Text="Lyrics" />
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource RibbonSeparator}" />

            <Grid Grid.Column="2" Margin="8,6,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,4,0,0">
                    <NumberBox x:Name="FadeBox" x:Uid="Ribbon_FadeWidth" Header="Fade width" Minimum="0" Value="0.5" Width="88" MinHeight="28" />
                </StackPanel>
                <TextBlock x:Name="WordCaption" x:Uid="Ribbon_PrevWord" Grid.Row="1" Style="{StaticResource RibbonCaption}" Text="Word" />
            </Grid>
            <Border Grid.Column="3" Style="{StaticResource RibbonSeparator}" />

            <Grid Grid.Column="4" Margin="8,6,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,4,0,0">
                    <NumberBox x:Name="FontBox" x:Uid="Ribbon_PrevFont" Header="Font (px)" Minimum="1" Value="16" Width="80" MinHeight="28" />
                    <CheckBox x:Uid="Ribbon_Vsync" Content="VSync" VerticalAlignment="Bottom" />
                    <AppBarButton x:Uid="Ribbon_Fullscreen" Icon="FullScreen" Label="Fullscreen" IsCompact="True" ToolTipService.ToolTip="Fullscreen" />
                </StackPanel>
                <TextBlock x:Name="ViewCaption" x:Uid="Ribbon_PrevView" Grid.Row="1" Style="{StaticResource RibbonCaption}" Text="View" />
            </Grid>
            <Border Grid.Column="5" Style="{StaticResource RibbonSeparator}" />

            <Grid Grid.Column="6" Margin="8,6,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,2,0,0">
                    <Slider x:Name="EmphasisSlider" x:Uid="Ribbon_Emphasis" Header="Emphasis" Maximum="200" Minimum="0" Value="100" Width="96" />
                    <Slider x:Name="GlowSlider" x:Uid="Ribbon_Glow" Header="Glow" Maximum="200" Minimum="0" Value="100" Width="96" />
                    <Slider x:Name="LiftSlider" x:Uid="Ribbon_Lift" Header="Lift" Maximum="200" Minimum="0" Value="100" Width="96" />
                    <Slider x:Name="AnimSpeedSlider" x:Uid="Ribbon_AnimSpeed" Header="Anim speed" Maximum="200" Minimum="20" Value="100" Width="96" />
                    <Slider x:Name="InactiveScaleSlider" x:Uid="Ribbon_InactiveScale" Header="Inactive scale" Maximum="100" Minimum="50" Value="97" Width="96" />
                    <Slider x:Name="CascadeSlider" x:Uid="Ribbon_Cascade" Header="Cascade" Maximum="200" Minimum="0" Value="100" Width="96" />
                    <Slider x:Name="BlurSlider" x:Uid="Ribbon_BlurStrength" Header="Blur" Maximum="200" Minimum="0" Value="100" Width="96" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <CheckBox x:Uid="Ribbon_InactiveBlur" Content="Inactive blur" IsChecked="True" />
                        <CheckBox x:Uid="Ribbon_PlusLighter" Content="Plus lighter" IsChecked="True" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StyleCaption" x:Uid="Ribbon_PrevStyle" Grid.Row="1" Style="{StaticResource RibbonCaption}" Text="Style" />
            </Grid>
            <Border Grid.Column="7" Style="{StaticResource RibbonSeparator}" />

            <Grid Grid.Column="8" Margin="8,6,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,2,0,0">
                    <Slider x:Name="BrightnessSlider" x:Uid="Ribbon_Brightness" Header="Brightness" Maximum="150" Minimum="20" Value="100" Width="96" />
                    <Slider x:Name="ContrastSlider" x:Uid="Ribbon_Contrast" Header="Contrast" Maximum="150" Minimum="50" Value="100" Width="96" />
                    <Slider x:Name="SaturationSlider" x:Uid="Ribbon_Saturation" Header="Saturation" Maximum="200" Minimum="0" Value="100" Width="96" />
                    <CheckBox x:Uid="Ribbon_BgEnabled" Content="Shader BG" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <CheckBox x:Uid="Ribbon_BgStatic" Content="Static" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <CheckBox x:Uid="Ribbon_AutoContrast" Content="Auto contrast" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </StackPanel>
                <TextBlock x:Name="BgCaption" x:Uid="Ribbon_PrevBg" Grid.Row="1" Style="{StaticResource RibbonCaption}" Text="Background" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
